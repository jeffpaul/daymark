{
    "name": "jeffpaul/daymark",
    "description": "Mark — mobile-first WordPress publishing prototype. Dev dependencies for testing only.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^4.0",
        "wp-coding-standards/wpcs": "^3.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpcompatibility/php-compatibility": "^9.3"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "phpcs": "phpcs",
        "phpcs:fix": "phpcbf",
        "phpcs-tests": "phpcs --standard=phpcs-tests.xml.dist",
        "phpcompat": "phpcs --standard=PHPCompatibility --runtime-set testVersion 8.1- daymark.php uninstall.php includes blocks templates"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
