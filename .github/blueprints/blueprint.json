{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Mark — Personal Site Publisher Mode",
    "description": "Try Daymark in a throwaway WordPress. Lands in the /daymark app shell, logged in as admin.",
    "author": "jeffpaul",
    "categories": ["publishing", "mobile"]
  },
  "preferredVersions": {
    "wp": "latest"
  },
  "login": true,
  "landingPage": "/daymark",
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/jeffpaul/daymark",
        "ref": "main",
        "path": "/"
      },
      "options": {
        "activate": true
      }
    }
  ]
}
