{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Moment — Personal Site Publisher Mode",
    "description": "Try Moment in a throwaway WordPress. Lands in the /moment app shell, logged in as admin.",
    "author": "jeffpaul",
    "categories": ["publishing", "mobile"]
  },
  "preferredVersions": {
    "wp": "latest"
  },
  "login": true,
  "landingPage": "/moment",
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/jeffpaul/moment",
        "ref": "main",
        "path": "/"
      },
      "options": {
        "activate": true
      }
    }
  ]
}
